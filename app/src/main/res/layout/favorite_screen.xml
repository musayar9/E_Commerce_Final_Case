<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.screens.FavoriteScreen">


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Favorite Screen"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />




    <LinearLayout
        android:id="@+id/emptyList"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="308dp"
        android:background="@drawable/rounded_gray_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingVertical="20dp"


        >

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="150dp"

            android:layout_height="120dp"
            android:layout_weight="1"
            android:src="@drawable/empty_favorite"
            android:paddingBottom="10dp"/>

        <TextView
            android:id="@+id/emptyListMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:lineHeight="20dp"
            android:paddingHorizontal="20dp"
            android:text="@string/empty_message"
            android:textAlignment="center"
            android:textColor="@color/gray150"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
    android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/recyclerFavorite"
            android:textFontWeight="@integer/material_motion_duration_medium_1"
            />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>